{
    "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "modules-left": ["tray", "custom/seperator", "hyprland/workspaces"],
        "modules-center": ["custom/date", "custom/seperator","clock"],
        "modules-right": [
          "pulseaudio",
          "custom/seperator",
          "backlight",
          "custom/seperator",
          "custom/localscan",
          "custom/seperator",
          "cpu",
          "memory",
          "custom/seperator",
          "custom/micmute",
          "custom/seperator",
          "bluetooth",
          "custom/seperator",
          "battery",
          "custom/battery_notify",
        ],

        "custom/date": {
            "tooltip": false,
            "exec": "date '+ %A, %d'",
            "interval": 60,
	    "on-click": "gnome-calendar"
	},

	"hyprland/workspaces": {
    	    "format": "{name}",
    	    "format-icons": {
    	    	"active": "",
   	    	"default": "",
    	    	"empty": ""
	    }, 
 	    "all-outputs": true,
      "active-only": false,
      "on-scroll-up": "hyprctl dispatch workspace e+1",
      "on-scroll-down": "hyprctl dispatch workspace e-1",
      "show-special": true
	},
        "clock": {
            "format": "{:%I:%M} ",
            "interval": 1,   
            "tooltip-format": "",
            "calendar": {
                "format": {
                    "today": "<span color='#fAfBfC'><b>{}</b></span>"
                }
            }
        },

        "bluetooth": {
            "format-on": "󰂯",
            "format-off": "BT-off",
            "format-disabled": "󰂲",
            "format-connected-battery": "{device_battery_percentage}% 󰂯",
            "format-alt": "{device_alias} 󰂯",
            "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
            "on-click": "",
        }, 
        "battery": {
            "interval":30,
            "states": {
                "good": 95,
                "warning": 20,
                "critical": 10
            },
            "format": "{capacity}% {icon}",
            "format-charging": "{capacity}% 󰂄",
            "format-plugged": "{capacity}% 󰂄 ",
            "format-alt": "{time} {icon}",
            "format-icons": [
                "󰁻",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰂂",
            "󰁹"
            ],
        },
        "cpu": {
            "format": "",
            "tooltip": true,
	    "on-click": "kitty --class=htop -e htop"
        },
        "temperature": {
            "critical-threshold": 80,
            "format": "",
        },
        "tray": {
            "icon-size": 14,
            "spacing": 10
        },
	"pulseaudio": {
	    "format": "  {volume}%",
    	    "format-muted": "  0%",
            "on-click": "pamixer -t",
    	    "on-scroll-up": "pamixer -i 5",
    	    "on-scroll-down": "pamixer -d 5",
    	    "tooltip": false
	},
	"backlight": {
    	    "device": "intel_backlight",
    	    "format": "󰖙 {percent}%",
	    "tooltip": false
	},
	"custom/seperator": {
	    "format": " | ",
	    "tooltip": false
	},

  "custom/battery_notify": {
    "exec": "~/.config/waybar/scripts/battery_notify.sh",
    "interval": 60, // check every 60 seconds
    "restart-interval": 0,
    "return-type": "empty"
  },

  "custom/micmute": {
    "exec": "pactl get-source-mute @DEFAULT_SOURCE@ | grep -q 'yes' && echo ' ' || echo ''",
    "interval": 60,
    "tooltip": false,
    "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  },
  
  "memory": {
    "interval": 5,
    "format": "{used:0.1f}G/{total:0.1f}G",
    "format-alt": "{percentage}%",
    "tooltip": true
  }, 

  "custom/localscan": {
    "exec": "~/.config/waybar/scripts/localscan.sh",
    "interval": 30,
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },

  "network": {
      "interval": 5,
      "format-wifi": " ",
      "format-ethernet": "󰈀  Wired",
      "format-disconnected": "󰖪  Offline",
      "tooltip-format": "{essid}\n{ipaddr}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "
      kitty --title gazelle --override font_size=10 -e gazelle"
    },

  "cava": {
          "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
          "framerate": 30,
          "autosens": 1,
          "sensitivity": 100,
          "bars": 14,
          "lower_cutoff_freq": 50,
          "higher_cutoff_freq": 10000,
          "hide_on_silence": false,
          // "format_silent": "quiet",
          "method": "pulse",
          "source": "auto",
          "stereo": true,
          "reverse": false,
          "bar_delimiter": 0,
          "monstercat": false,
          "waves": false,
          "noise_reduction": 0.77,
          "input_delay": 2,
          "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
          "actions": {
                     "on-click-right": "mode"
                     }
    },
} 
